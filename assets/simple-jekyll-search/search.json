---
layout: null
---
{% if site.data.sidebar.search.enable %}
[
  {% assign searchable_pages = site.pages | where_exp: "item", "item.title" %}
  {% for post in site.posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.category }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "date"     : "{{ post.date }}",
      {% if site.data.sidebar.search.full_text_search %}
      "content"  : {{ post.content | jsonify }},
      {% endif %}
      "url"      : "{{ post.url | relative_url }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if site.posts.size > 0 and searchable_pages.size > 0 %},{% endif %}
  {% for page in searchable_pages %}
   {
     "title"    : "{{ page.title | escape }}",
     "category" : "{{ page.category }}",
     "tags"     : "{{ page.tags | join: ', ' }}",
     "date"     : "{{ page.date }}",
     {% if site.data.sidebar.search.full_text_search %}
     "content"  : {{ page.content | jsonify }},
     {% endif %}
     "url"      : "{{ page.url | relative_url }}"
   } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
{% endif %}
